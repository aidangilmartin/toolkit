{
  "name": "gun-soundpack-maker",
  "productName": "Gun Soundpack Maker",
  "version": "0.1.0",
  "description": "Desktop app for building server-side FiveM gun sound packs from your own audio.",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && npm run build:bridge && electron-builder",
    "dist:win": "npm run build && npm run build:bridge -- --rid win-x64 && electron-builder --win",
    "dist:linux": "npm run build && npm run build:bridge -- --rid linux-x64 && electron-builder --linux",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"*.{ts,json,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"*.{ts,json,yml}\"",
    "postinstall": "install-electron",
    "build:bridge": "node scripts/build-bridge.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "prettier": "^3.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "~4.0.18"
  },
  "author": "aidangilmartin"
}
