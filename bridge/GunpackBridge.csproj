<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gunpack-bridge</AssemblyName>
    <RootNamespace>GunpackBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- System.Speech creates the voice's culture (e.g. en-US); allow that in invariant mode -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CodeWalker.Core built by scripts/build-bridge.mjs from a pinned commit (see CODEWALKER_COMMIT there). -->
    <CodeWalkerRuntime Condition="'$(CodeWalkerRuntime)' == ''">$(MSBuildThisFileDirectory).codewalker/runtime/</CodeWalkerRuntime>
  </PropertyGroup>

  <ItemGroup>
    <!-- CodeWalker by dexyfex: compiled against, never shipped. The player downloads CodeWalker and the bridge loads it from there (see Program.UseCodeWalker). -->
    <Reference Include="CodeWalker.Core">
      <HintPath>$(CodeWalkerRuntime)CodeWalker.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>$(CodeWalkerRuntime)SharpDX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(CodeWalkerRuntime)SharpDX.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Windows voices for the in-game ID pack (speak command); a no-op stub elsewhere -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
