{
  "settings": [
    {
      "key": "video/Windowed",
      "label": "Screen type",
      "description": "Fullscreen gives the most FPS; borderless makes alt-tabbing to Discord painless.",
      "group": "display",
      "control": {
        "kind": "select",
        "options": [
          {
            "value": "0",
            "label": "Fullscreen"
          },
          {
            "value": "1",
            "label": "Windowed"
          },
          {
            "value": "2",
            "label": "Windowed borderless"
          }
        ]
      },
      "capture": "default",
      "verified": true
    },
    {
      "key": "video/VSync",
